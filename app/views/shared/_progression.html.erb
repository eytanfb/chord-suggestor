<div id="progression" class="mt-1" data-progression="<%= progression.chord_groups.to_json %>">
  <div class="flex flex-wrap gap-2">
    <% progression.chord_groups.each_with_index do |chord_group_mode, index| %>
      <% chord = chord_group_mode[:chord_group].primary_chord.name %>
      <% mode = chord_group_mode[:mode].downcase %>

      <div
        class="progression-chord text-modes-<%= mode %>"
        data-chord="<%= chord %>"
        data-mode="<%= mode %>"
        data-action="mouseover->home#handleProgressionChordHover click->home#handleProgressionChordClick"
        data-controller="home"
      >
        <span
          class="remove-chord absolute hidden -top-1.5 -right-1.5 w-4 h-4 bg-state-muted rounded-full text-[10px] text-white flex items-center justify-center hover:cursor-pointer hover:bg-red-600 active:scale-90 transition-all"
          data-action="click->home#removeChord"
          data-controller="home"
          data-chord="<%= chord %>"
          data-mode="<%= mode %>"
        >&times;</span>
        <% if chord == 'Silence' %>
          <span class="text-[#555]"><i class="fas fa-volume-off text-xs"></i></span>
        <% else %>
          <span class="font-mono font-semibold text-xs leading-tight text-center"><%= chord %></span>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
