<div class="top-bar px-4 py-3" data-controller="home">
  <div class="flex items-center justify-between gap-4">

    <%# === Left: Title + Key Selector === %>
    <div class="flex items-center gap-4">
      <h1 class="text-sm font-mono font-bold uppercase tracking-widest text-hw-text-primary">Chord Suggestor</h1>

      <div class="section-divider"></div>

      <div class="key-display">
        <button
          class="key-display-arrow"
          data-action="click->home#prevKey"
          title="Previous key"
        >&lsaquo;</button>
        <div id="key-display-value" class="key-display-value" data-keys="<%= @keys.map(&:name).to_json %>" data-current-key="<%= @key %>">
          <%= @key || '—' %>
        </div>
        <button
          class="key-display-arrow"
          data-action="click->home#nextKey"
          title="Next key"
        >&rsaquo;</button>
      </div>
    </div>

    <%# === Center: Controls === %>
    <div class="flex items-center gap-4">
      <button
        id="show-7ths"
        class="hw-toggle <%= 'hw-toggle-on' if @is_seventh %>"
        data-action="click->home#toggle7ths"
        data-active="<%= @is_seventh %>"
      >7TH</button>

      <div class="section-divider"></div>

      <div class="hw-pill-group">
        <button
          class="hw-pill <%= 'hw-pill-active-purple' if @perspective == 'primary' %>"
          data-action="click->home#updatePerspective"
          data-value="primary"
        >PRI</button>
        <button
          class="hw-pill <%= 'hw-pill-active-purple' if @perspective == 'secondary_dominants' %>"
          data-action="click->home#updatePerspective"
          data-value="secondary_dominants"
        >V/x</button>
        <button
          class="hw-pill <%= 'hw-pill-active-purple' if @perspective == 'diminished_approaches' %>"
          data-action="click->home#updatePerspective"
          data-value="diminished_approaches"
        >DIM</button>
      </div>

      <div class="section-divider"></div>

      <div class="hw-pill-group">
        <button
          class="hw-pill <%= 'hw-pill-active-cyan' if @order_by == 'degree' %>"
          data-action="click->home#updateScaleOrder"
          data-value="degree"
        >DEG</button>
        <button
          class="hw-pill <%= 'hw-pill-active-cyan' if @order_by == 'mode' %>"
          data-action="click->home#updateScaleOrder"
          data-value="mode"
        >MODE</button>
      </div>

      <div class="section-divider"></div>

      <button
        id="mute-preview"
        class="hw-toggle"
        data-action="click->home#toggleMute"
        data-active="false"
      >MUTE</button>
    </div>

    <%# === Right: Transport + BPM + Utilities === %>
    <div class="flex items-center gap-4">
      <div class="flex items-center gap-2">
        <span class="text-[10px] font-mono uppercase tracking-wider text-hw-text-secondary">BPM</span>
        <input
          id="bpm"
          type="range"
          class="bpm-fader"
          value="120"
          min="60"
          max="200"
          data-controller="progression"
          data-action="input->progression#updateBpm"
        />
        <span id="bpm-label" class="bpm-lcd">120</span>
      </div>

      <div class="section-divider"></div>

      <div class="flex items-center gap-1.5">
        <span
          id="progression-controls-loop"
          class="hw-transport hw-transport-loop"
          data-loop="false"
          data-controller="progression"
          data-action="click->progression#updateLoop"
          title="Loop"
        >
          <i class="fas fa-rotate-right text-sm"></i>
        </span>
        <span
          id="progression-controls-play"
          class="hw-transport hw-transport-play"
          data-controller="progression"
          data-action="click->progression#playProgression"
          title="Play"
        >
          <i class="fas fa-play text-sm"></i>
        </span>
        <span
          id="progression-controls-stop"
          class="hidden hw-transport hw-transport-stop"
          data-controller="progression"
          title="Stop"
        >
          <i class="fas fa-stop text-sm"></i>
        </span>
      </div>

      <div class="section-divider"></div>

      <div class="flex items-center gap-1.5">
        <button class="hw-util-btn" data-action="click->home#clearProgression">CLR</button>
        <button class="hw-util-btn" data-action="click->home#addSilenceToProgression">SIL</button>
        <button class="hw-util-btn text-state-active" data-action="click->home#saveProgression" title="Save to Supabase">SAVE</button>
        <button class="hw-util-btn text-state-hover" data-action="click->home#loadProgressions" title="Load from Supabase">LOAD</button>
      </div>
    </div>
  </div>

  <span id="progression-help" class="hidden ml-4 text-xs font-mono text-state-selected">Select a chord to start</span>
</div>
