<div class="note-visualizer">
  <div class="flex flex-col items-center justify-center min-h-[100px]">
    <div id="chord-notes" class="flex flex-col items-center">
      <div class="text-3xl font-mono font-bold text-hw-text-secondary mb-1">—</div>
      <div class="text-sm font-mono text-[#555]">hover a chord</div>
    </div>
  </div>

  <div class="mt-4 border-t border-[#222] pt-4">
    <div id="mini-piano" class="flex justify-center gap-0.5">
      <% @keys.each do |key| %>
        <% is_black = key.name.include?('#') || key.name.include?('b') %>
        <div
          class="mini-key <%= is_black ? 'mini-black-key' : 'mini-white-key' %>"
          data-note="<%= key.name %>"
          data-sample="<%= asset_path(note_asset_name(key.name)) %>"
        >
          <span class="text-[7px] font-mono">
            <%= key.name.gsub('#', "\u266F").gsub('b', "\u266D") %>
          </span>
        </div>
      <% end %>
    </div>
  </div>
</div>
