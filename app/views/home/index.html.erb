<div class="hidden text-green"></div>
<div class="flex flex-col h-full" data-controller="home">
  <%= render partial: "home/top_bar" %>

  <% if @key %>
    <div class="flex-1 grid grid-cols-5 gap-3 p-3 overflow-hidden">
      <div class="col-span-3">
        <%= render partial: "home/chord_grid", locals: { chords: @chords } %>
      </div>

      <div class="col-span-2 flex flex-col gap-3">
        <%= render partial: "home/note_visualizer" %>

        <div class="progression-container">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-xs font-mono font-bold uppercase tracking-widest text-hw-text-secondary">Sequencer</h3>
          </div>
          <turbo-frame id="progression-display">
            <div id="progression-container" data-hovering="false" data-playing="false">
              <% if @progression %>
                <%= render partial: "shared/progression", locals: { progression: @progression } %>
              <% else %>
                <div class="flex flex-wrap gap-2">
                  <% 8.times do %>
                    <div class="ghost-step">+</div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </turbo-frame>
        </div>
      </div>
    </div>
  <% else %>
    <div class="flex-1 flex items-center justify-center">
      <div class="text-center">
        <div class="text-5xl text-faceplate-edge mb-4">
          <i class="fas fa-music"></i>
        </div>
        <h2 class="text-lg font-mono text-hw-text-secondary mb-2">Select a Key</h2>
        <p class="text-sm text-[#555]">Choose a key from the controls above</p>
      </div>
    </div>
  <% end %>
</div>
