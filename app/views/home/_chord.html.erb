<div
  class="group chord-box hover:shadow-[inset_0_0_15px_theme('colors.modes.<%= mode.downcase %>')] hover:text-white"
  data-action="mouseover->home#displayChordNotes mouseleave->home#cancelChordPlay click->home#selectChord"
  data-chord-notes="<%= chord.display_joined_notes %>"
  data-mode="<%= mode.downcase %>"
  data-chord="<%= chord.name %>"
  data-chord-group="<%= chord_group.to_json %>"
>
  <span class="degree-badge"><%= degree_label(index, chord.quality) %></span>
  <div class="group-hover:text-modes-<%= mode.downcase %> text-hw-text-secondary group-hover:font-bold text-center leading-tight"><%= chord.name %></div>
</div>
